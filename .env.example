# ─────────────────────────────────────────
# PLANEADOR ACADÉMICO UDEA — Variables de entorno
# Copiar este archivo como .env y completar los valores
# NUNCA subir .env al repositorio (está en .gitignore)
# ─────────────────────────────────────────

# ── API de Anthropic (Claude) ──
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ── Seguridad ──
SECRET_KEY=cambia-esto-por-una-clave-segura-de-64-caracteres
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── Base de datos ──
DATABASE_URL=postgresql://udea:udea2024@db:5432/planeador
POSTGRES_USER=udea
POSTGRES_PASSWORD=udea2024
POSTGRES_DB=planeador

# ── Redis ──
REDIS_URL=redis://redis:6379

# ── Entorno ──
ENVIRONMENT=development   # development | staging | production

# ── Frontend ──
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=Planeador Académico UdeA

# ── Nube (completar según proveedor elegido) ──
# AWS
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=planeador-udea-assets

# GCP
# GOOGLE_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=

# Azure
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TENANT_ID=
